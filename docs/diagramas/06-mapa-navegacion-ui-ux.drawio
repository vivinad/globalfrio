  <diagram id="diag_06" name="06-Mapa-Navegacion-UI-UX">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="header_banner" value="&lt;font style='font-size: 20px; font-weight: bold; color: #a9bed2;'&gt;GLOBAL FRÍO SAC — SIST1402A (UPN 2026-2)&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size: 16px; font-weight: bold; color: #ffffff;'&gt;DIAGRAMA 06: MAPA DE NAVEGACIÓN UI/UX, SITEMAP Y FLUJO DE EXPERIENCIA DE USUARIO&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color: #5980a6;'&gt;Ecosistema Frontend Angular 18: Portal Público Landing Page, Modal de Cotización en 3 Pasos y Paneles Administrativos Protegidos&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#15181a;strokeColor=#5980a6;strokeWidth=2;fontColor=#ffffff;align=left;spacingLeft=25;fontFamily=Barlow, Arial, sans-serif;" parent="1" vertex="1">
          <mxGeometry x="20" y="20" width="1760" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="zone_pub" value="ZONA PÚBLICA (LANDING PAGE '/')" style="swimlane;whiteSpace=wrap;html=1;fillColor=#1c2023;strokeColor=#5980a6;strokeWidth=2;fontColor=#ffffff;fontSize=13;fontStyle=1;startSize=30;align=center;" parent="1" vertex="1">
          <mxGeometry x="30" y="100" width="500" height="1100" as="geometry"/>
        </mxCell>
        <mxCell id="ui_header" value="&lt;b&gt;HeaderComponent&lt;/b&gt;&lt;br/&gt;• Logo Global Frío (PNG mix-blend)&lt;br/&gt;• Menú: Servicios, Trabajos, Mantenimiento, Ubicación&lt;br/&gt;• Botón 'Cotizar Ahora' (Abre Modal Cotizador)&lt;br/&gt;• Ambiente Toggle: [data-theme='claro'/'oscuro']" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15181a;strokeColor=#3d5c7b;strokeWidth=1;fontColor=#e8eaeb;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="50" y="145" width="460" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="ui_hero" value="&lt;b&gt;HeroComponent&lt;/b&gt;&lt;br/&gt;• Claim: 'Frescura que te acompaña'&lt;br/&gt;• Subtítulo: 'Los mejores Especialistas en HVAC'&lt;br/&gt;• KPIs Industriales: 24/7 | 6 Meses | 100% Garantía&lt;br/&gt;• CTA Primario: 'Solicitar Presupuesto'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f5fa9;strokeColor=#a9bed2;strokeWidth=1.5;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;" parent="1" vertex="1">
          <mxGeometry x="50" y="250" width="460" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="ui_serv" value="&lt;b&gt;ServiciosComponent (4 Tarjetas de Servicios)&lt;/b&gt;&lt;br/&gt;• 01: Instalación de Equipos Mini-Split y Comerciales&lt;br/&gt;• 02: Mantenimiento Preventivo y Correctivo&lt;br/&gt;• 03: Reparación Especializada de Tarjetas Inverter&lt;br/&gt;• 04: Venta de Equipos Gree &amp; Samsung" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15181a;strokeColor=#3d5c7b;strokeWidth=1;fontColor=#e8eaeb;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="50" y="360" width="460" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="ui_trab" value="&lt;b&gt;TrabajosComponent&lt;/b&gt;&lt;br/&gt;• Galería fotográfica con tratamiento Duotone Acero&lt;br/&gt;• Filtros de proyectos: Comercial, Industrial, Residencial" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15181a;strokeColor=#3d5c7b;strokeWidth=1;fontColor=#e8eaeb;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="50" y="470" width="460" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="ui_mant" value="&lt;b&gt;MantenimientoComponent (Banda Invertida --gf-band)&lt;/b&gt;&lt;br/&gt;• Checklist Semestral: Limpieza, Refrigerante, Drenaje, Eléctrico" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15181a;strokeColor=#3d5c7b;strokeWidth=1;fontColor=#e8eaeb;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="50" y="560" width="460" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="ui_ubic" value="&lt;b&gt;UbicacionComponent (Google Maps Embed)&lt;/b&gt;&lt;br/&gt;• Base: 4VJ7+W28 K, Ventanilla 07061, Lima / Callao&lt;br/&gt;• Contacto: Edgar Sabalu | Móvil: 904 209 489&lt;br/&gt;• Botón Flotante y Enlace Directo a WhatsApp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15181a;strokeColor=#3d5c7b;strokeWidth=1;fontColor=#e8eaeb;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="50" y="650" width="460" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="ui_foot" value="&lt;b&gt;FooterComponent&lt;/b&gt;&lt;br/&gt;• Redes Oficiales: Facebook SYSFRIOSAB | TikTok @edgarsabalu01&lt;br/&gt;• Enlaces institucionales, términos de garantía y Copyright 2026" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15181a;strokeColor=#3d5c7b;strokeWidth=1;fontColor=#e8eaeb;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="50" y="750" width="460" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="zone_modal" value="MODAL COTIZADOR AUTOMATIZADO EN 3 PASOS (CotizadorModalComponent)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#1c2023;strokeColor=#5980a6;strokeWidth=2;fontColor=#ffffff;fontSize=13;fontStyle=1;startSize=30;align=center;" parent="1" vertex="1">
          <mxGeometry x="560" y="100" width="540" height="1100" as="geometry"/>
        </mxCell>
        <mxCell id="mod_step1" value="&lt;b&gt;PASO 1: RECOMENDADOR TÉRMICO DE CAPACIDAD BTU&lt;/b&gt;&lt;br/&gt;• Inputs Reactivos: Área (m²), Personas, Equipos, Sol (Baja/Med/Alta)&lt;br/&gt;• Motor de Cálculo: Base 600 BTU/m² + Factor Solar&lt;br/&gt;• Recomendación de Equipo: Tarjeta Gree / Samsung (12k/18k/24k)&lt;br/&gt;• Botón 'Siguiente: Personalizar Instalación →'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f5fa9;strokeColor=#a9bed2;strokeWidth=1.5;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;" parent="1" vertex="1">
          <mxGeometry x="580" y="150" width="500" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="mod_step2" value="&lt;b&gt;PASO 2: COTIZADOR EN VIVO &amp; ADJUNTOS TÉCNICOS&lt;/b&gt;&lt;br/&gt;• Selección de Metraje de Cañería: Barra deslizante (3m a 20m)&lt;br/&gt;• Selector de Distrito: Recargo de flete zonal dinámico&lt;br/&gt;• Cargador Drag &amp; Drop de Archivos (Fotos de obra / Planos)&lt;br/&gt;• &lt;b&gt;Validación Magic Bytes:&lt;/b&gt; Acepta solo PDF (%PDF) y JPG/PNG&lt;br/&gt;• Desglose en Vivo en Pantalla: Subtotal, Flete, IGV 18%, Total&lt;br/&gt;• Botón 'Siguiente: Datos de Contacto →'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2c4560;strokeColor=#5980a6;strokeWidth=1.5;fontColor=#ffffff;fontSize=11;align=center;" parent="1" vertex="1">
          <mxGeometry x="580" y="275" width="500" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="mod_step3" value="&lt;b&gt;PASO 3: CONFIRMACIÓN, CONTACTO &amp; EMISIÓN DE FOLIO&lt;/b&gt;&lt;br/&gt;• Formulario de Cliente: DNI/RUC, Razón Social, Teléfono WhatsApp&lt;br/&gt;• Botón de Acción: 'Generar Solicitud Formal'&lt;br/&gt;• Despacho HTTP: POST /api/cotizaciones/publica&lt;br/&gt;• Emisión de Folio: &lt;b&gt;UUID de Seguimiento&lt;/b&gt;&lt;br/&gt;• Enlace directo para consultar proforma estimada o contactar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a2415;strokeColor=#f59e0b;strokeWidth=2;fontColor=#fcd34d;fontSize=11;fontStyle=1;align=center;" parent="1" vertex="1">
          <mxGeometry x="580" y="430" width="500" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="mod_report" value="&lt;b&gt;Vista Imprimible Server-Side Thymeleaf (/reportes/cotizacion/{id})&lt;/b&gt;&lt;br/&gt;• Proforma membretada con branding oficial de Global Frío SAC&lt;br/&gt;• Exportable a PDF con snapshots inmutables" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15181a;strokeColor=#3d5c7b;strokeWidth=1;fontColor=#e8eaeb;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="580" y="570" width="500" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="zone_priv" value="ZONAS PRIVADAS PROTEGIDAS (AuthGuard &amp; RoleGuard)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#1c2023;strokeColor=#5980a6;strokeWidth=2;fontColor=#ffffff;fontSize=13;fontStyle=1;startSize=30;align=center;" parent="1" vertex="1">
          <mxGeometry x="1130" y="100" width="640" height="1100" as="geometry"/>
        </mxCell>
        <mxCell id="priv_login" value="&lt;b&gt;Pantalla de Autenticación (/login)&lt;/b&gt;&lt;br/&gt;• Formulario Reactivo: Username y Password&lt;br/&gt;• Servicio AuthService -&gt; POST /api/auth/login&lt;br/&gt;• Guarda token en SessionStorage y redirige según Rol:&lt;br/&gt;  → ROLE_ASESOR: Redirige a /panel/solicitudes&lt;br/&gt;  → ROLE_ADMIN: Redirige a /panel/tarifario" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2c4560;strokeColor=#5980a6;strokeWidth=1.5;fontColor=#ffffff;fontSize=11;align=center;" parent="1" vertex="1">
          <mxGeometry x="1150" y="150" width="600" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="priv_asesor" value="&lt;b&gt;PANEL ASESOR COMERCIAL (canActivate: ROLE_ASESOR)&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;/panel/solicitudes:&lt;/b&gt; Bandeja de solicitudes públicas entrantes,&lt;br/&gt;  visor de fotos/planos adjuntos de visita técnica, ajuste de metraje y&lt;br/&gt;  botón 'Emitir Cotización Formal' (Genera COT-2026-XXXX y congela snapshots)&lt;br/&gt;• &lt;b&gt;/panel/ordenes:&lt;/b&gt; Gestión de órdenes de servicio post-aprobación,&lt;br/&gt;  asignación del técnico Edgar Sabalu y control de checklist operativo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f5fa9;strokeColor=#a9bed2;strokeWidth=1.5;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;" parent="1" vertex="1">
          <mxGeometry x="1150" y="275" width="600" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="priv_admin" value="&lt;b&gt;PANEL ADMINISTRADOR (canActivate: ROLE_ADMIN)&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;/panel/tarifario:&lt;/b&gt; Matriz de precios base, costo por metro adicional de tubería (S/ 65.00) y zonificación de fletes de Lima Metropolitana&lt;br/&gt;• &lt;b&gt;/panel/catalogo:&lt;/b&gt; ABM de Equipos HVAC Gree/Samsung, stock, actualización de precios y estadoStock (@Transient)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2c4560;strokeColor=#5980a6;strokeWidth=1.5;fontColor=#ffffff;fontSize=11;align=center;" parent="1" vertex="1">
          <mxGeometry x="1150" y="425" width="600" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="priv_error" value="&lt;b&gt;RUTAS DE ERROR &amp; EXCEPCIÓN&lt;/b&gt;&lt;br/&gt;• /404: Página No Encontrada con estética industrial Blueprint&lt;br/&gt;• /403: Acceso Denegado por falta de privilegios RBAC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15181a;strokeColor=#3d5c7b;strokeWidth=1;fontColor=#e8eaeb;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;" parent="1" vertex="1">
