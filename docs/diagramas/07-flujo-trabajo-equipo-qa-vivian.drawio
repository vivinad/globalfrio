        </mxCell>
        <mxCell id="qa_fix" value="&lt;b&gt;9. REPARACIÓN DIRECTA EN FUENTES&lt;/b&gt;&lt;br/&gt;&lt;b&gt;El compañero de QA modifica el código:&lt;/b&gt;&lt;br/&gt;Corrige validaciones, JPQL, DTOs o CSS&lt;br/&gt;Re-ejecuta pruebas hasta lograr 100% verde" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#143823;strokeColor=#10b981;strokeWidth=2;fontColor=#6ee7b7;fontSize=10;fontStyle=1;align=center;" parent="1" vertex="1">
