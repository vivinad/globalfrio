        <mxCell id="qa_tests" value="&lt;b&gt;7. Ejecución Batería de Pruebas&lt;/b&gt;&lt;br/&gt;• Unitarias &amp; MockMvc (./mvnw test)&lt;br/&gt;• Rollback Atómico @Transactional&lt;br/&gt;• Pruebas API Postman &amp; Swagger UI&lt;br/&gt;• Matriz Responsive RNF03 (360px+)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15181a;strokeColor=#3d5c7b;strokeWidth=1;fontColor=#e8eaeb;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;" parent="1" vertex="1">
