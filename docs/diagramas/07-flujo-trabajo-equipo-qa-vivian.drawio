        <mxCell id="1" parent="0"/>
        <mxCell id="header_banner" value="&lt;font style='font-size: 20px; font-weight: bold; color: #a9bed2;'&gt;GLOBAL FRÍO SAC — SIST1402A (UPN 2026-2)&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size: 16px; font-weight: bold; color: #ffffff;'&gt;DIAGRAMA 07: FLUJO DE TRABAJO COLABORATIVO EN 4 CARRILES (SWIMLANES), QA BUG-FIXING Y HITOS UPN&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color: #5980a6;'&gt;Dinámica de Equipo: Orlando (Backend/BD) → Compañero QA (Bug-Fixer Activo) → Vivian (PO/Frontend) → Hitos Académicos (T1, T2, T3, Final)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#15181a;strokeColor=#5980a6;strokeWidth=2;fontColor=#ffffff;align=left;spacingLeft=25;fontFamily=Barlow, Arial, sans-serif;" parent="1" vertex="1">
          <mxGeometry x="20" y="20" width="1760" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="lane_orlando" value="CARRIL 1: ORLANDO DORIVAL&lt;br/&gt;Arquitecto de Sistemas, Líder Backend &amp; Base de Datos" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#1c2023;strokeColor=#5980a6;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=1;startSize=36;align=center;" parent="1" vertex="1">
          <mxGeometry x="30" y="100" width="1790" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="o_req" value="&lt;b&gt;1. Requerimientos &amp; Arquitectura&lt;/b&gt;&lt;br/&gt;• Análisis del Sílabo SIST1402A&lt;br/&gt;• Topología N-Capas Monorepo&lt;br/&gt;• Migración Vanilla a Angular Base" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15181a;strokeColor=#3d5c7b;strokeWidth=1;fontColor=#e8eaeb;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="80" y="130" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="o_db" value="&lt;b&gt;2. Modelado de Persistencia&lt;/b&gt;&lt;br/&gt;• DDL 11 Tablas Normalizadas (3FN)&lt;br/&gt;• Columnas snapshot_* inmutables&lt;br/&gt;• Script data-seed-globalfrio.sql" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15181a;strokeColor=#3d5c7b;strokeWidth=1;fontColor=#e8eaeb;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="360" y="130" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="o_be" value="&lt;b&gt;3. Implementación Backend Spring Boot&lt;/b&gt;&lt;br/&gt;• Controladores REST &amp; Thymeleaf SSR&lt;br/&gt;• Capa @Service con @Transactional&lt;br/&gt;• Patrones Decorator, Factory, Singleton&lt;br/&gt;• Seguridad Spring Security 6 &amp; JWT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15181a;strokeColor=#3d5c7b;strokeWidth=1;fontColor=#e8eaeb;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="640" y="130" width="270" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="o_build" value="&lt;b&gt;4. Verificación Local Orlando&lt;/b&gt;&lt;br/&gt;./mvnw clean compile&lt;br/&gt;Build inicial sin errores" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2c4560;strokeColor=#5980a6;strokeWidth=1.5;fontColor=#ffffff;fontSize=10;align=center;" parent="1" vertex="1">
