        <mxCell id="qa_deploy" value="&lt;b&gt;6. Recepción &amp; Despliegue Local&lt;/b&gt;&lt;br/&gt;Clona rama orlando-docs-backend&lt;br/&gt;Levanta H2 / MySQL y Frontend 4200" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15181a;strokeColor=#3d5c7b;strokeWidth=1;fontColor=#e8eaeb;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;" parent="1" vertex="1">
