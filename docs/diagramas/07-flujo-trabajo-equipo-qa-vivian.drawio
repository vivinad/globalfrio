        <mxCell id="qa_diag" value="&lt;b&gt;8. DIAGNÓSTICO EN CÓDIGO FUENTE&lt;/b&gt;&lt;br/&gt;Compañero de QA no solo reporta:&lt;br/&gt;Revisa trazas de error en consola/logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#381b1b;strokeColor=#ef4444;strokeWidth=2;fontColor=#fca5a5;fontSize=10;fontStyle=1;align=center;" parent="1" vertex="1">
