        <mxCell id="uml_dec1" value="&lt;b&gt;InstalacionEstandarDecorator&lt;/b&gt;&lt;br/&gt;+ COSTO_BASE = S/ 350.00&lt;br/&gt;(Mano de obra + Kit básico 3m)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15181a;strokeColor=#3d5c7b;strokeWidth=1;fontColor=#e8eaeb;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;" parent="1" vertex="1">
