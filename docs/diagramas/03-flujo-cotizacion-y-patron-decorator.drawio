  <diagram id="diag_03" name="03-Flujo-Cotizacion-Decorator">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="header_banner" value="&lt;font style='font-size: 20px; font-weight: bold; color: #a9bed2;'&gt;GLOBAL FRÍO SAC — SIST1402A (UPN 2026-2)&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size: 16px; font-weight: bold; color: #ffffff;'&gt;DIAGRAMA 03: PIPELINE DE COTIZACIÓN Y PATRÓN GOF DECORATOR (BIGDECIMAL)&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size: 11px; color: #5980a6;'&gt;Algoritmo Termodinámico de Carga Térmica BTU, Arquitectura de Clases Decorator y Pipeline Numérico Financiero en Soles (S/)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#15181a;strokeColor=#5980a6;strokeWidth=2;fontColor=#ffffff;align=left;spacingLeft=25;fontFamily=Barlow, Arial, sans-serif;" parent="1" vertex="1">
          <mxGeometry x="20" y="20" width="1760" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="lane_btu" value="PARTE A: ALGORITMO TERMODINÁMICO DE CARGA TÉRMICA BTU (LIMA RESIDENCIAL / COMERCIAL)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#1c2023;strokeColor=#5980a6;strokeWidth=2;fontColor=#ffffff;fontSize=13;fontStyle=1;startSize=30;align=center;" parent="1" vertex="1">
          <mxGeometry x="30" y="100" width="520" height="1100" as="geometry"/>
        </mxCell>
        <mxCell id="btu_in" value="&lt;b&gt;Parámetros de Entrada del Recinto:&lt;/b&gt;&lt;br/&gt;• Área en metros cuadrados (m²): e.g. &lt;b&gt;25.0 m²&lt;/b&gt;&lt;br/&gt;• Ocupación de personas: e.g. &lt;b&gt;3 personas&lt;/b&gt;&lt;br/&gt;• Equipos electrónicos (PCs, servidores): e.g. &lt;b&gt;2 equipos&lt;/b&gt;&lt;br/&gt;• Incidencia de Radiación Solar: &lt;b&gt;Media (+10%)&lt;/b&gt;&lt;br/&gt;• Tipo de espacio: Comercial / Oficina" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15181a;strokeColor=#3d5c7b;strokeWidth=1;fontColor=#e8eaeb;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="50" y="145" width="480" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="btu_form" value="&lt;b&gt;Reglas de Cálculo y Factores Termodinámicos:&lt;/b&gt;&lt;br/&gt;1. Carga Base Recinto = Área (m²) × 600 BTU/m²&lt;br/&gt;   → 25 m² × 600 = &lt;b&gt;15 000 BTU&lt;/b&gt;&lt;br/&gt;2. Carga por Personas = (Personas - 1) × 600 BTU&lt;br/&gt;   → (3 - 1) × 600 = &lt;b&gt;1 200 BTU&lt;/b&gt;&lt;br/&gt;3. Carga Equipos = Cantidad Equipos × 400 BTU&lt;br/&gt;   → 2 × 400 = &lt;b&gt;800 BTU&lt;/b&gt;&lt;br/&gt;4. Subtotal Carga Térmica = 15 000 + 1 200 + 800 = &lt;b&gt;17 000 BTU&lt;/b&gt;&lt;br/&gt;5. Ajuste Radiación Solar (Media = +10%):&lt;br/&gt;   → 17 000 BTU × 1.10 = &lt;b&gt;18 700 BTU/hr Requeridos&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e2e3e;strokeColor=#5980a6;strokeWidth=2;fontColor=#ffffff;fontSize=11;align=center;" parent="1" vertex="1">
          <mxGeometry x="50" y="275" width="480" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="btu_dec" value="&lt;b&gt;Decisión de Selección en Catálogo Oficial Global Frío:&lt;/b&gt;&lt;br/&gt;• Capacidad Estándar Inferior: 12 000 BTU/hr (Insuficiente: generaría sobreesfuerzo de compresor)&lt;br/&gt;• Capacidad Estándar Óptima: &lt;b&gt;18 000 BTU/hr (1.5 TR)&lt;/b&gt;&lt;br/&gt;• Selección de Equipo: &lt;b&gt;Samsung WindFree Inverter 18K BTU (SAM-DVM-18K)&lt;/b&gt;&lt;br/&gt;• Cumplimiento ODS 09: Eficiencia energética e Inverter ecológico R32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f5fa9;strokeColor=#a9bed2;strokeWidth=1.5;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;" parent="1" vertex="1">
          <mxGeometry x="50" y="475" width="480" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="btu_out" value="&lt;b&gt;Contrato de Salida DTO hacia Decorator:&lt;/b&gt;&lt;br/&gt;• sku: 'SAM-DVM-18K'&lt;br/&gt;• precioBase: S/ 2 980.00 (BigDecimal)&lt;br/&gt;• metrosTuberiaSolicitados: 8.0 metros (Exceso: 5.0m)&lt;br/&gt;• distritoId: 3 (San Miguel - Flete: S/ 40.00)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15181a;strokeColor=#3d5c7b;strokeWidth=1;fontColor=#e8eaeb;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="50" y="625" width="480" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="lane_gof" value="PARTE B: ESTRUCTURA DE CLASES GOF DECORATOR (pe.upn.sist1402a.pattern.decorator)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#1c2023;strokeColor=#5980a6;strokeWidth=2;fontColor=#ffffff;fontSize=13;fontStyle=1;startSize=30;align=center;" parent="1" vertex="1">
          <mxGeometry x="580" y="100" width="600" height="1100" as="geometry"/>
        </mxCell>
        <mxCell id="uml_iface" value="&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;br/&gt;&lt;b&gt;PresupuestoCalculator&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;+ calcularSubtotal(): BigDecimal&lt;br/&gt;+ obtenerDescripcionDetallada(): String" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f5fa9;strokeColor=#a9bed2;strokeWidth=1.5;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;" parent="1" vertex="1">
          <mxGeometry x="730" y="150" width="300" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="uml_comp" value="&lt;b&gt;CostoBaseEquipoCalculator&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Componente Concreto)&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;- precioBase: BigDecimal&lt;br/&gt;- modeloSku: String&lt;br/&gt;- marca: String&lt;br/&gt;&lt;br/&gt;+ calcularSubtotal(): BigDecimal&lt;br/&gt;+ obtenerDescripcionDetallada(): String" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2c4560;strokeColor=#5980a6;strokeWidth=1.5;fontColor=#ffffff;fontSize=11;align=center;" parent="1" vertex="1">
          <mxGeometry x="600" y="280" width="240" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="uml_abs_dec" value="&lt;b&gt;abstract class PresupuestoDecorator&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Decorador Abstracto)&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;# decorador: PresupuestoCalculator&lt;br/&gt;&lt;br/&gt;+ PresupuestoDecorator(decorador)&lt;br/&gt;+ calcularSubtotal(): BigDecimal&lt;br/&gt;+ obtenerDescripcionDetallada(): String" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2c4560;strokeColor=#5980a6;strokeWidth=1.5;fontColor=#ffffff;fontSize=11;align=center;" parent="1" vertex="1">
