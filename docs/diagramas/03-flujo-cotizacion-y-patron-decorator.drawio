        <mxCell id="pipe_s2" value="&lt;b&gt;PASO 2: Decoración Instalación Estándar Especializada&lt;/b&gt;&lt;br/&gt;+ Instalación mano de obra técnica certificada = &lt;b&gt;S/ 350.00&lt;/b&gt;&lt;br/&gt;Subtotal Acumulado: &lt;b&gt;S/ 3 330.00&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e2e3e;strokeColor=#5980a6;strokeWidth=2;fontColor=#ffffff;fontSize=11;align=center;" parent="1" vertex="1">
