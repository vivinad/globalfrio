        <mxCell id="pipe_s3" value="&lt;b&gt;PASO 3: Decoración Metros Adicionales de Tubería de Cobre&lt;/b&gt;&lt;br/&gt;Distancia total entre condensadora y evaporadora: 8 metros&lt;br/&gt;Metros extra: 8 - 3 = 5 metros a S/ 65.00/m = &lt;b&gt;S/ 325.00&lt;/b&gt;&lt;br/&gt;Subtotal Acumulado: &lt;b&gt;S/ 3 655.00&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e2e3e;strokeColor=#5980a6;strokeWidth=2;fontColor=#ffffff;fontSize=11;align=center;" parent="1" vertex="1">
