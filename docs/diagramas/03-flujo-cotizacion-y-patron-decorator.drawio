        <mxCell id="pipe_s5" value="&lt;b&gt;PASO 5: Decoración Impuesto General a las Ventas (IGV 18%)&lt;/b&gt;&lt;br/&gt;Cálculo: S/ 3 695.00 × 0.18 = &lt;b&gt;S/ 665.10&lt;/b&gt; (HALF_UP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2c4560;strokeColor=#5980a6;strokeWidth=1.5;fontColor=#ffffff;fontSize=11;align=center;" parent="1" vertex="1">
