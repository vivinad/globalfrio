        <mxCell id="uml_singleton" value="&lt;b&gt;ParametrosComercialesSingleton&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Patrón GoF Singleton)&lt;/i&gt;&lt;br/&gt;Mantiene en memoria constantes regulatorias:&lt;br/&gt;• IGV = 0.18 | Límite Metros Base = 3.0m | Tarifa Metro = S/ 65.00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e2e3e;strokeColor=#5980a6;strokeWidth=2;fontColor=#ffffff;fontSize=11;align=center;" parent="1" vertex="1">
