        <mxCell id="uml_dec2" value="&lt;b&gt;MetrosAdicionalesTuberiaDecorator&lt;/b&gt;&lt;br/&gt;+ TARIFA_METRO = S/ 65.00&lt;br/&gt;+(metros - 3) * 65.00 en BigDecimal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15181a;strokeColor=#3d5c7b;strokeWidth=1;fontColor=#e8eaeb;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;" parent="1" vertex="1">
