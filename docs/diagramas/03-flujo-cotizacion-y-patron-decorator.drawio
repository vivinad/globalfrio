        <mxCell id="uml_dec5" value="&lt;b&gt;IGVCalculatorDecorator&lt;/b&gt;&lt;br/&gt;+ TASA_IGV = 0.18 (BigDecimal)&lt;br/&gt;setScale(2, RoundingMode.HALF_UP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15181a;strokeColor=#3d5c7b;strokeWidth=1;fontColor=#e8eaeb;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;" parent="1" vertex="1">
