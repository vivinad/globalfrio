        <mxCell id="pipe_s1" value="&lt;b&gt;PASO 1: Costo Base Equipo Samsung WindFree Inverter 18K&lt;/b&gt;&lt;br/&gt;precioBase = &lt;b&gt;S/ 2 980.00&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f5fa9;strokeColor=#a9bed2;strokeWidth=1.5;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;" parent="1" vertex="1">
