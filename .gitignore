# Monorepo Global Frío - .gitignore

# Node & Angular
**/node_modules/
**/dist/
**/.angular/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Java & Maven
**/target/
*.class
*.jar
*.war
*.ear
*.nar
.mvn/timing.properties
!.mvn/wrapper/maven-wrapper.jar

# IDEs & Editors
.idea/
*.iml
.vscode/
*.swp
*.swo
.project
.classpath
.settings/

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Logs & Temp
*.log
scratch/
tmp/
temp/
